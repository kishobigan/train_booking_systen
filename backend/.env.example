PORT=4050
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/train_booking
NODE_ENV=development
LOG_LEVEL=info

SERVICE_FEE_TYPE=PERCENTAGE
SERVICE_FEE_VALUE=2.50
FARE_TAX_ENABLED=true
FARE_TAX_PERCENTAGE=5.00
FARE_TAX_INCLUDES_SERVICE_FEE=true
MAX_PASSENGERS_PER_BOOKING=6
BOOKING_HOLD_MINUTES=10
TRANSACTION_MAX_RETRIES=3
JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_CHANGE_TOKEN_TTL_SECONDS=900
TEMPORARY_PASSWORD_TTL_HOURS=24
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

PAYMENT_CURRENCIES=LKR
PAYMENT_PENDING_EXPIRY_MINUTES=15
IDEMPOTENCY_TTL_HOURS=24
BANK_PAYMENT_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT_CODE=
BANK_PAYMENT_REFERENCE_PREFIX=TRAIN
BANK_SLIP_MAX_SIZE_MB=5
BANK_SLIP_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf
BANK_SLIP_STORAGE_ROOT=./storage/bank-slips
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
STRIPE_API_VERSION=

WAITLIST_ENABLED=true
WAITLIST_OFFER_MINUTES=15
WAITLIST_MAX_PASSENGERS=6
WAITLIST_REQUEUE_EXPIRED=false
WAITLIST_CANDIDATE_BATCH_SIZE=50

# Development admin account (seed only)
ADMIN_EMAIL=admin@trainbooking.local
ADMIN_PASSWORD=admin123
