NOTIFICATION_RETRY_BASE_MINUTES=2
NOTIFICATION_RETRY_MAX_MINUTES=60
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_PROCESSING_TIMEOUT_MINUTES=10
NOTIFICATION_RETENTION_DAYS=90
EMAIL_ENABLED=false
EMAIL_PROVIDER=SMTP
SMTP_HOST=
