SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

PAYMENT_CURRENCIES=LKR
PAYMENT_PENDING_EXPIRY_MINUTES=15
IDEMPOTENCY_TTL_HOURS=24
BANK_PAYMENT_ENABLED=false
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SWIFT_CODE=
